{
  "name": "lang-leak-checker",
  "version": "1.0.0",
  "description": "Element-level language-leak checker: scans HTML and flags every element that confidently reads as the wrong language. Official hunspell dictionaries + per-site loanword learning; multi-language (lingua wasm).",
  "homepage": "https://github.com/Nicktriez/lang-leak-checker#readme",
  "bugs": {
    "url": "https://github.com/Nicktriez/lang-leak-checker/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Nicktriez/lang-leak-checker.git"
  },
  "license": "MIT",
  "author": "Nicklas N. Jensen",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "main": "dist/cli.js",
  "scripts": {
    "test": "node --test --import tsx \"test/**/*.test.ts\"",
    "dev": "tsx src/cli.ts",
    "build": "tsc"
  },
  "bin": {
    "lang-leak-checker": "dist/cli.js"
  },
  "dependencies": {
    "cheerio": "^1.2.0",
    "commander": "^15.0.0",
    "dictionary-da": "^6.0.0",
    "dictionary-pl": "^2.0.0",
    "domhandler": "^6.0.1",
    "nspell": "^2.1.5",
    "playwright": "^1.62.1"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  },
  "files": [
    "dist",
    "wasm"
  ],
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
